<resources>

    <style name="AppThemeOverlay" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.Black" parent="AppTheme">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="materialFullScreenAlertDialogTheme">@style/AppTheme.Black</item>
    </style>

    <style name="AppTheme.TransparentBackground.Black" parent="AppTheme.TransparentBackground">
        <!-- Transparent chrome must remain transparent; accents stay dynamic. -->
        <item name="materialFullScreenAlertDialogTheme">@style/AppTheme.Black</item>
    </style>
    <!-- Root only: never override colorSurface or material container/button palette roles. -->
    <style name="ThemeOverlay.AppTheme.PureBlackRoot">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
